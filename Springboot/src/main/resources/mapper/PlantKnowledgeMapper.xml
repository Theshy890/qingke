<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qingke.mapper.PlantKnowledgeMapper">
    
    <resultMap id="BaseResultMap" type="com.qingke.entity.PlantKnowledge">
        <id column="id" property="id"/>
        <result column="plant_name" property="plantName"/>
        <result column="category_name" property="categoryName"/>
        <result column="img_url" property="imgUrl"/>
        <result column="video_url" property="videoUrl"/>
        <result column="maintain_tutorial" property="maintainTutorial"/>
        <result column="publish_date" property="publishDate"/>
        <result column="last_click_time" property="lastClickTime"/>
        <result column="click_num" property="clickNum"/>
        <result column="collect_num" property="collectNum"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM plant_knowledge ORDER BY create_time DESC
    </select>
    
    <select id="findByCondition" resultMap="BaseResultMap">
        SELECT * FROM plant_knowledge
        <where>
            <if test="plantName != null and plantName != ''">
                AND plant_name LIKE CONCAT('%', #{plantName}, '%')
            </if>
            <if test="categoryName != null and categoryName != ''">
                AND category_name LIKE CONCAT('%', #{categoryName}, '%')
            </if>
        </where>
        <choose>
            <when test="orderBy == 'clicknum'">
                ORDER BY click_num DESC, collect_num DESC
            </when>
            <when test="orderBy == 'fabushijian'">
                ORDER BY publish_date DESC
            </when>
            <otherwise>
                ORDER BY create_time DESC
            </otherwise>
        </choose>
    </select>
    
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM plant_knowledge WHERE id = #{id}
    </select>
    
    <delete id="deleteBatch">
        DELETE FROM plant_knowledge WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <update id="increaseClicknum">
        UPDATE plant_knowledge 
        SET click_num = IFNULL(click_num, 0) + 1,
            last_click_time = NOW()
        WHERE id = #{id}
    </update>
    
    <update id="increaseStoreupnum">
        UPDATE plant_knowledge 
        SET collect_num = IFNULL(collect_num, 0) + 1
        WHERE id = #{id}
    </update>
    
    <update id="decreaseStoreupnum">
        UPDATE plant_knowledge 
        SET collect_num = IFNULL(collect_num, 0) - 1
        WHERE id = #{id} AND collect_num > 0
    </update>
    
</mapper>